---
import Base from '../../layouts/Base.astro';
import LaserCheck from '../../components/LaserCheck.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'فاحص ملاءمة الليزر المنزلي',
  url: 'https://ikhtarsah.com/tools/laser-skin-check/',
  applicationCategory: 'HealthApplication',
  inLanguage: 'ar',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'SAR' },
};
---
<Base
  title="هل الليزر المنزلي يناسب بشرتي؟ فاحص مجاني | اختار صح"
  description="اختر لون بشرتك وشعرك واعرف فوراً إن كان جهاز الليزر المنزلي IPL مناسباً وآمناً لك، أو ما البديل الأنسب."
  schema={schema}
>
  <section class="wrap" style="padding-top:2.5rem">
    <h1>هل الليزر المنزلي يناسب بشرتك؟</h1>
    <p class="prose">أجهزة IPL المنزلية لا تناسب الجميع. قبل أن تدفع مئات الريالات، تأكد في أقل من دقيقة إن كانت حالتك من الحالات التي صُممت لها هذه الأجهزة.</p>
    <LaserCheck />
    <div class="prose">
      <h2>لماذا يهم لون البشرة والشعر؟</h2>
      <p>جهاز IPL يطلق ومضة ضوء تمتصها الصبغة الداكنة في الشعرة، فتتحول إلى حرارة تُضعف بصيلة الشعر. كلما كان الشعر أغمق والبشرة أفتح، اتجهت الطاقة إلى الشعر أكثر من الجلد.</p>
      <p>عندما يكون الشعر فاتحاً، لا يمتص الضوء بما يكفي فتضعف النتيجة. وعندما تكون البشرة داكنة، يمتص الجلد جزءاً من الطاقة فيرتفع خطر الحروق وتغيّر اللون. لهذا تضع الشركات المصنعة جداول ألوان بشرة في أدلة أجهزتها.</p>
      <h2>قبل أول استخدام</h2>
      <ul>
        <li>احلق المنطقة قبل الجلسة، ولا تستخدم الشمع أو النتف خلال فترة العلاج.</li>
        <li>جرّب ومضة اختبار على منطقة صغيرة وانتظر 24 ساعة.</li>
        <li>لا تستخدم الجهاز على الوشم أو الشامات الداكنة أو الجلد المحروق من الشمس.</li>
        <li>اتبع جدول ألوان البشرة الموجود في دليل جهازك تحديداً، فهو المرجع الأخير.</li>
      </ul>
      <p><a href="/guides/home-laser-hair-removal/">دليل اختيار جهاز الليزر المنزلي</a></p>
    </div>
  </section>
</Base>
