---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
---
<Base title="أدلة الشراء | اختار صح" description="أدلة شراء محايدة بالعربي تشرح الفرق بين الخيارات ومتى لا يناسبك المنتج.">
  <section class="wrap prose" style="padding-top:2.5rem">
    <h1>أدلة الشراء</h1>
    <h2>العناية الشخصية</h2>
    <ul>
      {guides.map((g) => <li><a href={g.href}>{g.title}</a> — {g.blurb}</li>)}
    </ul>
  </section>
</Base>
