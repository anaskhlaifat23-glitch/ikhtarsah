---
import Base from '../../layouts/Base.astro';

const published = '2026-11-07';
const faqs = [
  {
    q: 'هل نتيجة الليزر المنزلي دائمة؟',
    a: 'أجهزة IPL تقلل نمو الشعر وتجعله أخف وأبطأ مع الوقت، لكنها لا تضمن إزالة نهائية. أغلب المستخدمين يحتاجون جلسات صيانة متباعدة بعد انتهاء المرحلة الأولى.',
  },
  {
    q: 'هل جهاز IPL المنزلي مؤلم؟',
    a: 'أغلب الناس يصفون الإحساس بوخزة دافئة خفيفة. الإحساس يزيد في المناطق الحساسة ومع مستويات الطاقة العالية، لذلك تبدأ معظم الأجهزة بمستوى منخفض يمكنك رفعه تدريجياً.',
  },
  {
    q: 'هل يصلح الليزر المنزلي للبشرة السمراء؟',
    a: 'يعتمد على درجة السمرة والجهاز نفسه. بعض الأجهزة تدعم البشرة السمراء بطاقة أقل، ومعظمها غير مصمم للبشرة الداكنة جداً. استخدم فاحص الملاءمة، ثم راجع جدول ألوان البشرة في دليل الجهاز قبل الشراء.',
  },
  {
    q: 'متى أرى النتيجة؟',
    a: 'عادة تبدأ الفروق بالظهور بعد عدة جلسات منتظمة، لأن الضوء يؤثر على الشعر في مرحلة النمو فقط. الالتزام بالجدول الموجود في دليل الجهاز أهم من قوة الجهاز.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'كيف تختار جهاز ليزر منزلي (IPL) في السعودية',
    inLanguage: 'ar',
    datePublished: published,
    dateModified: published,
    author: { '@type': 'Organization', name: 'فريق اختار صح', url: 'https://ikhtarsah.com/about/' },
    publisher: { '@type': 'Organization', name: 'اختار صح', url: 'https://ikhtarsah.com/' },
    mainEntityOfPage: 'https://ikhtarsah.com/guides/home-laser-hair-removal/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const amz = (q: string) => `https://www.amazon.sa/s?k=${encodeURIComponent(q)}`;
const brands = [
  { name: 'Philips Lumea (سلسلة 8000 و9000)', q: 'Philips Lumea IPL', note: 'فيها حسّاس للون البشرة (SmartSkin) وملحقات مختلفة حسب المنطقة. الفرق بين السلسلتين في عدد الملحقات والمزايا الإضافية، فقارن قبل أن تدفع أكثر.' },
  { name: 'Beurer (IPL 8500 و IPL 5500)', q: 'Beurer IPL', note: 'ماركة ألمانية للأجهزة المنزلية. حسب وصف المنتج على أمازون، يأتي IPL 8500 بـ 300 ألف ومضة وبطارية مدمجة، و IPL 5500 بـ 200 ألف ومضة.' },
  { name: 'SmoothSkin', q: 'SmoothSkin IPL', note: 'أجهزة تركز على السرعة وعدد الومضات. تحقق من جدول ألوان البشرة للطراز الذي تختاره.' },
  { name: 'Roxa و MLAY', q: 'MLAY IPL', note: 'ماركات منتشرة بأسعار أقل، ولـ MLAY متجر رسمي على أمازون السعودية. عدد التقييمات على كثير من طرازاتها ما زال قليلاً، فاقرأ التقييمات المكتوبة بعناية.' },
];
---
<Base
  title="كيف تختار جهاز ليزر منزلي IPL في السعودية (دليل 2026) | اختار صح"
  description="دليل محايد بالعربي لاختيار جهاز الليزر المنزلي IPL: لمن يصلح ولمن لا يصلح، الفرق الحقيقي بين الأجهزة، وكيف تتجنب النسخ المقلدة على أمازون السعودية."
  schema={schema}
>
  <article class="wrap" style="padding-top:2.5rem">
    <div class="prose">
      <h1>كيف تختار جهاز ليزر منزلي (IPL) في السعودية</h1>
      <p class="meta">فريق اختار صح · نُشر في <time datetime={published}>7 نوفمبر 2026</time></p>
      <p class="disclosure">إذا اشتريت عن طريق روابطنا إلى أمازون السعودية نحصل على عمولة صغيرة، ولا يتغير السعر عليك. <a href="/disclosure/">كيف نتعامل مع العمولات</a></p>

      <div class="verdict-box">
        <div class="stamp">الخلاصة</div>
        <div>
          <p><strong>ابدأ بسؤال الملاءمة قبل سؤال الماركة.</strong> إن كان شعرك داكناً وبشرتك فاتحة إلى حنطية، فأنت الحالة التي صُممت لها هذه الأجهزة. إن كان شعرك أشقر أو أبيض، أو بشرتك داكنة جداً، فوفّر المال وابحث عن بديل.</p>
          <p>بعد ذلك، أهم ثلاثة أشياء في الجهاز: حسّاس للون البشرة، وملحق مناسب للمنطقة التي تريد علاجها، وأن يكون البائع موثوقاً.</p>
        </div>
      </div>

      <p><a class="btn" href="/tools/laser-skin-check/">افحص ملاءمة الليزر لبشرتك</a></p>

      <h2>كيف نكتب هذا الدليل</h2>
      <p>لم نجرّب هذه الأجهزة بأنفسنا حتى الآن. هذا الدليل مبني على طريقة عمل تقنية IPL، وعلى ما تنشره الشركات المصنّعة في أدلة أجهزتها، وعلى ما هو معروض فعلاً على أمازون السعودية وقت الكتابة. عندما نجرّب جهازاً سنكتب ذلك صراحة.</p>

      <h2>ما الذي يفرق بين جهاز وآخر فعلاً؟</h2>
      <h3>حسّاس لون البشرة</h3>
      <p>بعض الأجهزة تقرأ لون الجلد قبل كل ومضة، وتمنع الإطلاق أو تقترح مستوى أقل إن كانت البشرة أغمق مما يحتمله الإعداد. هذه أهم ميزة أمان، خصوصاً للبشرة الحنطية والسمراء، وتستحق أن تدفع فرق السعر من أجلها.</p>
      <h3>الملحقات حسب المنطقة</h3>
      <p>نافذة الوجه أصغر وأدق، ونافذة الجسم أكبر وأسرع. إن كنت ستعالج الوجه أو المناطق الحساسة، تأكد أن الملحق المناسب مضمَّن في العلبة ولا يُباع منفصلاً.</p>
      <h3>عدد الومضات</h3>
      <p>الرقم يمثل عمر المصباح التقريبي. أرقام مثل 300 ألف أو مليون ومضة تكفي سنوات من الاستخدام الشخصي في الغالب، فلا تجعل هذا الرقم وحده سبب اختيارك لجهاز أغلى.</p>
      <h3>سلك أم بطارية</h3>
      <p>البطارية أريح في الحركة، والسلك لا يتوقف في منتصف الجلسة. القرار هنا مسألة راحة لا جودة نتيجة.</p>
      <h3>الضمان والبائع</h3>
      <p>بعض المنتجات على أمازون السعودية تُشحن من خارج المملكة. هذا لا يعني أنها مقلدة، لكنه يصعّب الضمان والإرجاع. الأفضل أن يكون المنتج مباعاً أو مشحوناً من Amazon.sa، أو من المتجر الرسمي للماركة.</p>

      <h2>ماركات معروضة على أمازون السعودية الآن</h2>
      <p>هذه ليست قائمة ترتيب. هي الماركات الأكثر حضوراً في نتائج البحث وقت كتابة الدليل، مع ما يجب أن تتحقق منه في كل واحدة.</p>
    </div>

    <div class="brand-list">
      {brands.map((b) => (
        <section class="brand-card">
          <h3>{b.name}</h3>
          <p>{b.note}</p>
          <a href={amz(b.q)} rel="sponsored nofollow noopener" target="_blank">شاهد الطرازات والسعر الحالي على أمازون السعودية</a>
        </section>
      ))}
    </div>

    <div class="prose">
      <h2>توقعات واقعية</h2>
      <ul>
        <li>الضوء يؤثر على الشعر في مرحلة النمو فقط، لذلك تحتاج عدة جلسات منتظمة قبل أن تلاحظ الفرق.</li>
        <li>الجلسات الأولى تكون متقاربة، ثم تتباعد إلى جلسات صيانة. اتبع الجدول المكتوب في دليل جهازك.</li>
        <li>الحلاقة قبل الجلسة ضرورية، والشمع والنتف يُفسدان العلاج لأنهما يزيلان الشعرة من جذورها.</li>
      </ul>

      <h2>متى تستشير طبيباً أولاً</h2>
      <p>إن كانت لديك حالة جلدية، أو كنتِ حاملاً، أو تتناول أدوية تجعل الجلد حساساً للضوء، أو لديك شامات كثيرة في المنطقة، فاستشر طبيب جلدية قبل الشراء.</p>

      <h2>أسئلة شائعة</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </article>
</Base>

<style>
  .meta { color: var(--ink-soft); font-size: .95rem; }
  .brand-list { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin: 1.2rem 0 1rem; max-width: 980px; }
  .brand-card { border: 1px solid var(--line); border-radius: var(--radius-l); padding: 1.2rem 1.3rem; }
  .brand-card h3 { margin-top: 0; }
  .faq { border-bottom: 1px solid var(--line); padding: .8rem 0; }
  .faq summary { font-family: var(--display); font-weight: 600; cursor: pointer; }
  .faq p { margin: .6rem 0 0; }
</style>
