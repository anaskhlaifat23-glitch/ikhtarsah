---
import Base from './Base.astro';

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  path: string;
  published: string;
  publishedLabel: string;
  faqs?: { q: string; a: string }[];
}
const { title, seoTitle, description, path, published, publishedLabel, faqs = [] } = Astro.props;
const url = `https://ikhtarsah.com${path}`;
const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    inLanguage: 'ar',
    datePublished: published,
    dateModified: published,
    author: { '@type': 'Organization', name: 'فريق اختار صح', url: 'https://ikhtarsah.com/about/' },
    publisher: { '@type': 'Organization', name: 'اختار صح', url: 'https://ikhtarsah.com/' },
    mainEntityOfPage: url,
  },
];
if (faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={seoTitle} description={description} schema={schema}>
  <article class="wrap" style="padding-top:2.5rem">
    <div class="prose">
      <h1>{title}</h1>
      <p class="meta">فريق اختار صح · نُشر في <time datetime={published}>{publishedLabel}</time></p>
      <p class="disclosure">إذا اشتريت عن طريق روابطنا إلى أمازون السعودية نحصل على عمولة صغيرة، ولا يتغير السعر عليك. <a href="/disclosure/">كيف نتعامل مع العمولات</a></p>
    </div>
    <slot />
    {faqs.length > 0 && (
      <div class="prose">
        <h2>أسئلة شائعة</h2>
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    )}
  </article>
</Base>

<style>
  .meta { color: var(--ink-soft); font-size: .95rem; }
  .faq { border-bottom: 1px solid var(--line); padding: .8rem 0; }
  .faq summary { font-family: var(--display); font-weight: 600; cursor: pointer; }
  .faq p { margin: .6rem 0 0; }
  :global(.cmp) { border-collapse: collapse; width: 100%; max-width: 860px; margin: 1rem 0 1.6rem; font-size: .95rem; }
  :global(.cmp th), :global(.cmp td) { border: 1px solid var(--line); padding: .6rem .7rem; text-align: start; vertical-align: top; }
  :global(.cmp th) { background: var(--mist); font-family: var(--display); }
  :global(.table-scroll) { overflow-x: auto; }
</style>
