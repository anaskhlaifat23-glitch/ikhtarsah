---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  schema?: object;
  noindex?: boolean;
}
const { title, description, schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/guides/', label: 'أدلة الشراء' },
  { href: '/tools/', label: 'الأدوات' },
  { href: '/how-we-choose/', label: 'كيف نختار' },
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="mitgo-verification" content="dbb911be-5658-404e-93c3-2fa08aa6eb45" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:site_name" content="اختار صح" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Readex+Pro:wght@500;600;700&display=swap" rel="stylesheet" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
  <a href="#main" style="position:absolute;inset-inline-start:-999px" onfocus="this.style.insetInlineStart='1rem'">تخطَّ إلى المحتوى</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="اختار صح - الصفحة الرئيسية">
        <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0E6B4F"/><path d="M17 33l10 10 21-23" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        اختار صح
      </a>
      <nav class="site-nav" aria-label="القائمة الرئيسية">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p style="margin:0">بعض الروابط في الموقع قد تكون روابط تسويق بالعمولة. إذا اشتريت عن طريقها قد نحصل على عمولة صغيرة، ولا يتغير السعر عليك. العمولة لا تغيّر توصياتنا.</p>
      <div class="footer-links">
        <a href="/about/">من نحن</a>
        <a href="/how-we-choose/">كيف نختار</a>
        <a href="/disclosure/">الإفصاح عن العمولة</a>
        <a href="/privacy/">سياسة الخصوصية</a>
        <a href="/contact/">تواصل معنا</a>
      </div>
      <p style="margin:0">© {new Date().getFullYear()} اختار صح</p>
    </div>
  </footer>
  <Analytics />
</body>
</html>
